# Telephony Portal runtime settings (example)
# Copy to telephony.env and fill in values as needed.

# IMPORTANT: set a strong secret key for sessions
# You can generate one with PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object {Get-Random -Max 256}))
SECRET_KEY=CHANGE_ME

TELEPHONY_HOST=0.0.0.0
TELEPHONY_PORT=5500

# Production server / stability (recommended for shared server)
TELEPHONY_USE_WAITRESS=1
TELEPHONY_WAITRESS_THREADS=8
TELEPHONY_DESKTOP_DIALOGS=0

# Large imports: commit every N rows to keep the web UI responsive
TELEPHONY_IMPORT_BATCH_SIZE=500


