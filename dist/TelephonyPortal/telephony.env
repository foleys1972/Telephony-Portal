#
# Telephony Portal runtime settings
# This file is copied next to the EXE by build-exe.ps1 so the app is reachable on your LAN.
#

TELEPHONY_HOST=0.0.0.0
TELEPHONY_PORT=5500

# Production server / stability (recommended for shared server)
TELEPHONY_USE_WAITRESS=1
TELEPHONY_WAITRESS_THREADS=8
TELEPHONY_DESKTOP_DIALOGS=0

# Large imports: commit every N rows to keep the web UI responsive
TELEPHONY_IMPORT_BATCH_SIZE=500

# Logging
# On shared servers / services, stdout logging can block. Keep this off unless debugging.
TELEPHONY_LOG_STDOUT=0
# Enable extra import debug logs only when troubleshooting
TELEPHONY_IMPORT_DEBUG=0


